// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int     @id @default(autoincrement())
  name  String
  email String  @unique
  phone String?
}

model Metric {
  id          Int     @id @default(autoincrement())
  label       String
  value       String
  description String?
  category    String? // 'primary' for blue cards, 'secondary' for white cards
  trend       String? // e.g., '+2.3%'
}

model DashboardStat {
  id    Int     @id @default(autoincrement())
  name  String
  value String
  desc  String?
}

model FinansData {
  id    Int     @id @default(autoincrement())
  name  String
  value String
  desc  String?
}

model PolucheniyaData {
  id    Int     @id @default(autoincrement())
  name  String
  value String
  desc  String?
}

model SoliqData {
  id    Int     @id @default(autoincrement())
  name  String
  value String
  desc  String?
}


